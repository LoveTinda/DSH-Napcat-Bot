# 目的：模块级配置。真配置放 /data/adb/tinda-bot/etc/tinda.conf（0600，不入库）。
# 每个键都必须在 docs/配置说明.md 有一行说明（pre-commit 检查）。

PORT_MODE=unix
SOCKET_PATH=/data/adb/tinda-bot/run/bridge.sock
LOG_DIR=/data/adb/tinda-bot/logs
LOG_MAX_MB=50
STATE_DIR=/data/adb/tinda-bot/state
SECRETS_DIR=/data/adb/tinda-bot/secrets

# 业务进程降权目标 uid（必填）。用 `stat -c %u /data/data/com.termux` 取。
RUN_AS_UID=

# 稳定性
RESTART_BACKOFF_MAX=60
NODE_MAX_OLD_SPACE_MB=512
HEALTH_INTERVAL_SEC=30
STOP_TIMEOUT_SEC=5

# NapCat 单元（独立生命周期，见 docs/生命周期.md）
NAPCAT_ROOTFS=/data/adb/tinda-bot/napcat/rootfs
NAPCAT_QQ_ACCOUNT=
NAPCAT_WS_PORT=3001
NAPCAT_WS_TOKEN=

# Web 入口单元（units/web）
WEB_BIND=0.0.0.0
WEB_PORT=8443
WEB_REDIRECT_PORT=8088
WEB_LAN_IP=192.168.1.3

# 证书装不进信任库时的逃生口：明文直连端口（默认 0 = 关，仅调试）
WEB_HTTP_PORT=0
