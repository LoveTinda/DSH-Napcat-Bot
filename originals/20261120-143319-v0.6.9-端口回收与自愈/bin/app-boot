#!/bin/sh
# 目的：在 proot guest 里「先生成 app.json，再启动业务」。配置落在 guest 自己的 /tmp，
#       不依赖宿主与 guest 的路径映射是否一致（真机上出现过同一路径两份内容）。
# 边界：只生成配置并 exec node；不探测 proot、不拼参数、不写宿主状态。
# 依赖：node（guest 内）、bin/app-config.mjs、/tmp/tinda-template.json、/tmp/tinda-policy.json。
# 失败：生成失败就退回模板默认值并记一行；node 起不来按 exit 78 交回 unit.sh。
# 副作用：写 /tmp/tinda-app.json（guest 本地，每次启动重写）。

NODE=${NODE:-/usr/local/bin/node}
[ -x "$NODE" ] || NODE=$(command -v node)
[ -n "$NODE" ] || { echo "[bridge] guest 里没有 node" >&2; exit 78; }

TPL=${TPL:-/tmp/tinda-template.json}
CONF=${CONF:-/tmp/tinda-app.json}
POLICY=${POLICY:-/tmp/tinda-policy.json}
API=${NAPCAT_API:-ws://127.0.0.1:3001}
ENTRY=${ENTRY:-/tmp/tinda-app/src/index.js}

[ -f "$TPL" ] || { echo "[bridge] 缺配置模板：$TPL" >&2; exit 78; }

if "$NODE" /tmp/tinda-bin/app-config.mjs "$TPL" "$CONF" "$POLICY" "$API" >/dev/null 2>&1; then
  echo "[bridge] 配置已生成：$CONF（策略来自 $POLICY）"
else
  echo "[bridge] 生成配置失败，退回模板默认值" >&2
  cp "$TPL" "$CONF" 2>/dev/null || { echo "[bridge] 连模板都写不进去" >&2; exit 78; }
fi
[ -s "$CONF" ] || { echo "[bridge] 配置文件是空的：$CONF" >&2; exit 78; }

# 内部端口自愈：旧实例残留会把 6701/6702 占着，应用会直接退出（真机出现过）。
"$NODE" /tmp/tinda-bin/port-fix.mjs "$CONF" || echo "[bridge] 端口检查跳过" >&2

exec "$NODE" "$ENTRY" "$CONF"
